---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | Christian Wijaya"
  description="The requested Christian Wijaya page could not be found."
>
  <section class="not-found">
    <h1>Page Not Found</h1>
    <p>The page you requested does not exist.</p>
    <a href="/">Return Home</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 60vh;
    display: grid;
    place-content: center;
    gap: 1rem;
    padding: 4rem 2rem;
    text-align: center;
  }
  .not-found h1 {
    margin: 0;
    color: #d4af37;
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 7vw, 5rem);
  }
  .not-found p {
    margin: 0;
  }
  .not-found a {
    justify-self: center;
    padding: 0.8rem 1.5rem;
    border: 1px solid #d4af37;
    color: #8a6d12;
  }
</style>
