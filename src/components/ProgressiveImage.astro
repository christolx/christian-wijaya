---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  imageClass?: string;
  wrapperClass?: string;
  widths?: number[];
  sizes?: string;
  loading?: 'eager' | 'lazy';
}

const {
  src,
  alt,
  imageClass,
  wrapperClass,
  widths,
  sizes,
  loading = 'eager'
} = Astro.props;
---

<div
  class:list={['progressive-image', wrapperClass]}
  data-progressive-image
  aria-busy="true"
  style={`--progressive-image-ratio: ${src.width} / ${src.height}`}
>
  <Image
    src={src}
    alt=""
    aria-hidden="true"
    class="progressive-image__placeholder"
    width={32}
    quality={20}
    format="webp"
    loading={loading}
    decoding="async"
  />
  <Image
    src={src}
    alt={alt}
    class:list={['progressive-image__full', imageClass]}
    widths={widths}
    sizes={sizes}
    loading={loading}
    decoding="async"
  />
</div>

<script>
  const reveal = async (container: HTMLElement, image: HTMLImageElement) => {
    try {
      await image.decode();
    } catch {
      // A cached image or a failed decode can still paint normally.
    }
    container.dataset.loaded = 'true';
    container.setAttribute('aria-busy', 'false');
  };

  document.querySelectorAll<HTMLElement>('[data-progressive-image]').forEach((container) => {
    const image = container.querySelector<HTMLImageElement>('.progressive-image__full');
    if (!image) return;
    if (image.complete) void reveal(container, image);
    else image.addEventListener('load', () => void reveal(container, image), { once: true });
    image.addEventListener('error', () => {
      container.dataset.error = 'true';
      container.setAttribute('aria-busy', 'false');
    }, { once: true });
  });
</script>
