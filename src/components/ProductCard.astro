---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';
import { formatPrice } from '../data/products';

interface Props {
  product: Product;
  variant?: 'collection' | 'related';
}

const { product, variant = 'collection' } = Astro.props;
const related = variant === 'related';
---

{related ? (
  <article class="related-products__item">
    <div class="related-products__image-container">
      <Image src={product.image} alt={product.imageAlt} class="related-products__image" widths={[320, 520]} sizes="(max-width: 768px) 100vw, 25vw" loading="eager" decoding="auto" />
      <div class="related-products__overlay">
        <a href={`/products/${product.slug}`} class="related-products__view">View Details</a>
      </div>
    </div>
    <h3 class="related-products__name">{product.name}</h3>
    <p class="related-products__price">{formatPrice(product.price)}</p>
  </article>
) : (
  <article class="products__item" data-category={product.category} data-price={product.price} data-name={product.name} data-product-card>
    <div class="products__image-container">
      <Image src={product.image} alt={product.imageAlt} class="products__image" widths={[360, 600]} sizes="(max-width: 768px) 100vw, 33vw" loading="eager" decoding="auto" />
      <div class="products__overlay">
        <a href={`/products/${product.slug}`} class="products__view">View Details</a>
      </div>
    </div>
    <h3 class="products__name">{product.name}</h3>
    <p class="products__category">{product.categoryLabel}</p>
    <p class="products__price">{formatPrice(product.price)}</p>
  </article>
)}
